{
  "name": "question-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "vite-node scripts/export-samples.ts",
    "crosscheck": "vite-node scripts/export-samples.ts 40 > .samples.jsonl && python3 -I scripts/crosscheck.py .samples.jsonl",
    "quality": "vite-node scripts/quality-report.ts"
  },
  "dependencies": {
    "@fontsource/kalam": "5.3.0",
    "@fontsource/stix-two-text": "5.3.0",
    "katex": "0.16.22",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
